rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Secure user-scoped collections: entries, goals, reminders, settings
    match /entries/{entryId} {
      // Allow read if user owns the document or if it is a legacy document with no userId
      allow read: if request.auth != null && (
        !('userId' in resource.data) || resource.data.userId == null || resource.data.userId == '' || resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Allow update if user owns the document or is claiming a legacy document with no userId
      allow update: if request.auth != null && (
        !('userId' in resource.data) || resource.data.userId == null || resource.data.userId == '' || resource.data.userId == request.auth.uid
      ) && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Generic fallback for any user-specific document with userId field
    match /{document=**} {
      allow read, write: if request.auth != null && (
        (resource == null || resource.data.userId == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid)
      );
    }
  }
}
