rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Entries collection: Users can only read, create, update, or delete their own transactions
    match /entries/{entryId} {
      // Allow access if user is authenticated and the record belongs to them
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email);
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || request.resource.data.userEmail == request.auth.token.email);
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email);
    }

    // Goals collection
    match /goals/{goalId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email);
    }

    // Reminders collection
    match /reminders/{reminderId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email);
    }

    // Default fallback: Deny everything else
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
